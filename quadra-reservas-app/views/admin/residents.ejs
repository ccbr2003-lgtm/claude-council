<%- include('../partials/header', { title: 'Moradores', currentUser, active: 'admin' }) %>
<p><a href="/admin">&larr; administração</a></p>
<h1>Moradores</h1>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<% if (ok) { %><div class="alert ok"><%= ok %></div><% } %>

<div class="card">
  <h2 class="mt0">Cadastrar morador</h2>
  <form method="post" action="/admin/moradores" class="field-row">
    <div class="field"><label>Nome</label><input type="text" name="name" required></div>
    <div class="field"><label>E-mail</label><input type="email" name="email" required></div>
    <div class="field"><label>Apartamento</label><input type="text" name="apartment" required></div>
    <div class="field"><label>Senha inicial</label><input type="text" name="password" placeholder="moradia123"></div>
    <button class="btn" type="submit">Cadastrar</button>
  </form>
</div>

<div class="card">
  <h2 class="mt0">Todos os moradores</h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>Nome</th><th>Apto</th><th>E-mail</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% residents.forEach(r => { %>
        <tr>
          <td><%= r.name %></td>
          <td><%= r.apartment %></td>
          <td><%= r.email %></td>
          <td><span class="badge <%= r.active ? '' : 'danger' %>"><%= r.active ? 'Ativo' : 'Inativo' %></span></td>
          <td>
            <% if (r.active) { %>
              <form method="post" action="/admin/moradores/<%= r.id %>/desativar"><button class="btn danger small" type="submit">Desativar</button></form>
            <% } else { %>
              <form method="post" action="/admin/moradores/<%= r.id %>/ativar"><button class="btn secondary small" type="submit">Reativar</button></form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!residents.length) { %><tr><td colspan="5" class="muted">Nenhum morador cadastrado.</td></tr><% } %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/footer') %>
