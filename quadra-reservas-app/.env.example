# Copie este arquivo para .env e ajuste os valores antes de rodar em produção.

PORT=3000

# Troque por um valor aleatório longo em produção (assinatura da sessão de login).
SESSION_SECRET=troque-este-valor-em-producao

# Usados apenas pelo script `npm run seed`, na primeira execução:
ADMIN_NAME=Síndico(a)
ADMIN_EMAIL=sindico@condominio.local
ADMIN_APARTMENT=Administração
ADMIN_PASSWORD=

# SEED_DEMO=true cria também 4 moradores de exemplo (só use em ambiente de teste).
SEED_DEMO=false
