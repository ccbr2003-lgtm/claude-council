<%- include('partials/header', { title: 'Meu perfil', currentUser, active: '' }) %>
<h1>Meu perfil</h1>
<div class="card">
  <p><strong><%= currentUser.name %></strong> · apto <%= currentUser.apartment %> · <%= currentUser.email %></p>
  <p class="muted small">Perfil: <%= currentUser.role === 'sindico' ? 'Síndico(a)' : 'Morador(a)' %></p>
</div>
<div class="card">
  <h2 class="mt0">Trocar senha</h2>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <% if (ok) { %><div class="alert ok"><%= ok %></div><% } %>
  <form method="post" action="/minha-senha">
    <div class="field" style="margin-bottom:0.6rem">
      <label>Senha atual</label>
      <input type="password" name="current_password" required>
    </div>
    <div class="field" style="margin-bottom:0.6rem">
      <label>Nova senha</label>
      <input type="password" name="new_password" required minlength="6">
    </div>
    <div class="field" style="margin-bottom:0.8rem">
      <label>Confirmar nova senha</label>
      <input type="password" name="new_password_confirm" required minlength="6">
    </div>
    <button class="btn" type="submit">Salvar nova senha</button>
  </form>
</div>
<%- include('partials/footer') %>
