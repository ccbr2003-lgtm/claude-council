<%- include('partials/header', { title: 'Horário fixo', currentUser, active: 'interesse' }) %>
<h1>Horário fixo trimestral</h1>
<p class="muted small">
  A cada trimestre você pode fixar até <%= limit %> horários por semana. Se mais de um morador quiser o mesmo
  horário, é feito um <strong>sorteio aleatório e auditável</strong> — não vale mais "quem chega primeiro na portaria".
  Se você já tinha aquele horário fixo no trimestre anterior e outro morador também se interessou por ele, você
  <strong>não concorre automaticamente de novo</strong> a esse horário específico (entra no rodízio); os outros
  horários que você pedir continuam concorrendo normalmente.
</p>

<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<% if (ok) { %><div class="alert ok"><%= ok %></div><% } %>

<% if (!quarter) { %>
  <div class="card"><p>Não há nenhum trimestre planejado no momento. Fale com a administração.</p></div>
<% } else { %>
  <div class="card">
    <h2 class="mt0"><%= quarter.label %> <span class="badge"><%= quarter.phase_label %></span></h2>
    <p class="small muted">
      Trimestre: <%= quarter.start_date %> a <%= quarter.end_date %> ·
      Janela de interesse: <%= quarter.interest_open_at %> a <%= quarter.interest_close_at %>
    </p>

    <% if (quarter.phase !== 'interesse_aberto') { %>
      <p class="muted">A janela de manifestação de interesse não está aberta agora.</p>
    <% } else { %>
      <p class="small">Seus pedidos: <strong><%= myInterests.length %>/<%= limit %></strong></p>
      <% if (myInterests.length) { %>
        <ul>
          <% myInterests.forEach(i => { %>
            <li>
              <%= weekdays[i.weekday] %> às <%= i.start_hour %>h
              <form class="inline" method="post" action="/interesse/<%= i.id %>/remover" style="display:inline">
                <button class="btn-link" type="submit">remover</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <% if (myInterests.length < limit) { %>
      <div class="table-wrap">
      <table>
        <thead>
          <tr><th></th><% weekdays.forEach((w,i) => { %><th><%= w %></th><% }) %></tr>
        </thead>
        <tbody>
          <% hours.forEach(hour => { %>
            <tr>
              <td class="muted"><%= hour %>h</td>
              <% weekdays.forEach((w, weekday) => { %>
                <% const already = myInterests.some(i => i.weekday === weekday && i.start_hour === hour); %>
                <td>
                  <% if (already) { %>
                    <span class="badge">pedido</span>
                  <% } else { %>
                    <form method="post" action="/interesse">
                      <input type="hidden" name="court_id" value="<%= court.id %>">
                      <input type="hidden" name="weekday" value="<%= weekday %>">
                      <input type="hidden" name="hour" value="<%= hour %>">
                      <button class="btn secondary small" type="submit">pedir</button>
                    </form>
                  <% } %>
                </td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <% } %>
    <% } %>
  </div>
<% } %>

<%- include('partials/footer') %>
